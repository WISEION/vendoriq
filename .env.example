# VendorIQ environment. Copy to infra/.env for docker compose, or to .env at the repository
# root for a native run. Never commit the filled-in file.

# ── application ─────────────────────────────────────────────────────────────
APP_ENV=development                 # development | staging | production
APP_NAME=VendorIQ
LOG_LEVEL=INFO
DEFAULT_LOCALE=az                   # az | en — Azerbaijani is the default (spec §13)

# ── authentication ──────────────────────────────────────────────────────────
# test: the accounts in docs/TEST_ACCOUNTS.md are seeded, OTP/TOTP codes appear in the server
#       log and in the dev banner, and the vendor code 000000 is accepted.
# live: real e-mail delivery, no codes revealed anywhere.
# The API refuses to start with AUTH_MODE=test while APP_ENV=production (brief §6).
AUTH_MODE=test
SESSION_SECRET=change-me-a-long-random-string
SESSION_COOKIE=vendoriq_session
ACCESS_TOKEN_TTL_MINUTES=480
OTP_TTL_MINUTES=10

# ── database ────────────────────────────────────────────────────────────────
# Native run (postgres on the host):
DATABASE_URL=postgresql+psycopg://vendoriq:vendoriq@localhost:5432/vendoriq
TEST_DATABASE_URL=postgresql+psycopg://vendoriq:vendoriq@localhost:5432/vendoriq_test
DB_ECHO=false
# docker compose overrides the host with the service name:
POSTGRES_USER=vendoriq
POSTGRES_PASSWORD=vendoriq
POSTGRES_DB=vendoriq

# ── document storage ────────────────────────────────────────────────────────
# local: filesystem under STORAGE_LOCAL_DIR — used for native dev and every test.
# s3:    any S3 API, i.e. MinIO in compose or a cloud bucket in production.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./var/storage
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=vendoriq
S3_ACCESS_KEY=vendoriq
S3_SECRET_KEY=vendoriq-secret
S3_REGION=us-east-1
MINIO_ROOT_USER=vendoriq
MINIO_ROOT_PASSWORD=vendoriq-secret

# ── e-mail ──────────────────────────────────────────────────────────────────
# With SMTP_HOST empty, messages are written to the log instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@vendoriq.local
SMTP_TLS=true

# ── web ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173"]
VITE_API_URL=http://localhost:8000

# ── deployment (compose) ────────────────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443
DOMAIN=localhost
# Dev: "tls internal" issues a local certificate. Prod: "tls ops@example.az" uses ACME.
TLS_DIRECTIVE=tls internal
