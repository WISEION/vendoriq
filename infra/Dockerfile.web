# Build the SPA, then serve the static bundle with nginx. Caddy proxies /api to the API
# container, so the bundle needs no API host baked in.
FROM node:22-alpine AS build
WORKDIR /app

COPY apps/web/package.json apps/web/package-lock.json ./
# `npm ci`, with no `|| npm install` behind it. The fallback would resolve fresh versions
# whenever the lock file and package.json disagreed, which is exactly the moment a build must
# stop instead of quietly shipping a dependency set nobody chose.
RUN npm ci --no-audit --no-fund

COPY apps/web/ ./
RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY infra/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
